{
  "name": "svg2tgs-app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "npm run wasm && vite --mode web",
    "build": "node scripts/check-locales.mjs && tsc --noEmit && vite build",
