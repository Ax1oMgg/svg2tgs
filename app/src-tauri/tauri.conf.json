{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "svg2tgs",
  "identifier": "io.github.chajnaya-axioma.svg2tgs",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "svg2tgs by Чайная Аксиома",
        "width": 1200,
        "height": 720,
        "minWidth": 900,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "category": "Graphics and Design",
    "shortDescription": "Конвертер SVG в стикеры и эмодзи Telegram",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "publisher": "Чайная Аксиома",
    "copyright": "© 2026 Чайная Аксиома. Автор — Ax1oM. MIT License.",
    "license": "MIT",
    "homepage": "https://github.com/Ax1oMgg/svg2tgs",
    "longDescription": "Превращает SVG в стикеры и эмодзи Telegram (TGS). Работает полностью локально, без интернета.",
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "section": "graphics"
      }
    }
  }
}
